# ---------------------------------------------------------------------------
# crm-erp-data-migration -- example configuration
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Nothing below is a real
# credential: these are local placeholders.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
# Holds two things: the simulated legacy CRM, and keystone's own migration
# state (crosswalk, rejects, runs, profiles).
KEYSTONE_DB_HOST=localhost
KEYSTONE_DB_PORT=5432
KEYSTONE_DB_NAME=keystone
KEYSTONE_DB_USER=keystone_app
KEYSTONE_DB_PASSWORD=change_me_local_only

KEYSTONE_LEGACY_SCHEMA=legacy
KEYSTONE_MIGRATION_SCHEMA=migration

# --- Target system (Atlas Cloud, simulated) --------------------------------
KEYSTONE_TARGET_BASE_URL=http://localhost:8080
KEYSTONE_TARGET_API_KEY=local_dev_key_not_a_secret
KEYSTONE_TARGET_TIMEOUT_SECONDS=30

# Records per write batch. The target refuses anything above its own limit,
# which is deliberately lower than you would guess.
KEYSTONE_BATCH_SIZE=200

# Retry policy for transient target failures (429, 5xx, connection errors).
KEYSTONE_RETRY_MAX_ATTEMPTS=5
KEYSTONE_RETRY_BASE_DELAY_SECONDS=0.5
KEYSTONE_RETRY_MAX_DELAY_SECONDS=30.0

# --- Target fault injection (demonstrates the write-side error handling) ----
# Probability that a batch is rate-limited (429 + Retry-After).
KEYSTONE_TARGET_RATE_LIMIT_RATE=0.06
# Probability that a batch fails outright with a 503.
KEYSTONE_TARGET_FAULT_RATE=0.05

# --- Migration policy ------------------------------------------------------
# A load refuses to start unless a dry-run for the same mapping version ran
# and its rejection rate stayed below this threshold.
#
# 5% is not a round number picked for comfort: the first dry-run against this
# dataset projected 3.26%, of which most is a cascade -- 27 companies rejected
# for an unmappable country take their contacts, opportunities and activities
# with them. The ceiling sits above that and below the level at which the
# migration would be losing something structural. Set it to 100 to disable the
# gate, and expect to be asked why in code review.
KEYSTONE_MAX_REJECT_RATE_PCT=5.0

# Records rejected by the target are retried at most this many times before
# being left for a human.
KEYSTONE_MAX_RETRY_ATTEMPTS=3

# --- Legacy data generation ------------------------------------------------
KEYSTONE_RANDOM_SEED=20260220
KEYSTONE_N_ACCOUNTS=1200
KEYSTONE_N_CONTACTS=4000
KEYSTONE_N_OPPORTUNITIES=2600
KEYSTONE_N_ACTIVITIES=9000
# Share of accounts deliberately duplicated under a different spelling.
KEYSTONE_DUPLICATE_RATE=0.06
# Share of records carrying at least one data-quality defect.
KEYSTONE_DEFECT_RATE=0.18

# --- Paths -----------------------------------------------------------------
KEYSTONE_DATA_DIR=data
KEYSTONE_MAPPING_DIR=mappings

# --- Runtime ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
KEYSTONE_LOG_LEVEL=INFO
# text | json
KEYSTONE_LOG_FORMAT=text
